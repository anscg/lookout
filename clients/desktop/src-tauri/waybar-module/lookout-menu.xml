<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkMenu" id="menu">
    <child>
      <object class="GtkMenuItem">
        <property name="label">Lookout</property>
        <property name="sensitive">False</property>
      </object>
    </child>
    <child>
      <object class="GtkSeparatorMenuItem"/>
    </child>
    <child>
      <object class="GtkMenuItem" id="toggle">
        <property name="label">Pause / resume recording</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="stop">
        <property name="label">Stop recording</property>
      </object>
    </child>
    <child>
      <object class="GtkSeparatorMenuItem"/>
    </child>
    <child>
      <object class="GtkMenuItem" id="open">
        <property name="label">Open Lookout</property>
      </object>
    </child>
  </object>
</interface>
