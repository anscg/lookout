# Tauri's stock template writes `Exec={{exec}}` with no %u, so a desktop
# file that claims x-scheme-handler/lookout launches the app WITHOUT the
# URL — deep links would open Lookout but never load anything. Identical
# to upstream except for the %u.
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %u
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
